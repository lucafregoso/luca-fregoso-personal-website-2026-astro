# Public deployment configuration. Copy to .env.local for local overrides.
# These values are not secrets: they appear in the generated site's URLs.
SITE_URL=https://lucafregoso.github.io
BASE_PATH=/luca-fregoso-personal-website-2026-astro/

# CV PDF generation (scripts/generate-cv-pdf.mjs).
# The generator renders from SITE_URL when set, falling back to the
# pnpm dev default (http://localhost:4600) when unset.
# CV_PHONE is personal data: set it in .env.local only, never commit it.
# It is injected into the generated PDF and never rendered in the /cv/ page.
CV_PHONE=
